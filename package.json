{
  "name": "chrome-ops-mcp",
  "version": "0.5.0-alpha.0",
  "description": "MCP server for Chrome DevTools, extension management, and browser settings via a local Chrome extension.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chrome-ops-mcp": "bin/chrome-ops-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "extension/",
    "helper/contract.ts",
    "helper/windows/",
    "helper/macos/Package.swift",
    "helper/macos/Sources/",
    "scripts/",
    "docs/ARCHITECTURE.md",
    "docs/AUDIT_READ.md",
    "docs/CLIENTS.md",
    "docs/HELPER_WINDOWS.md",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "host": "node dist/host.js",
    "setup": "npm ci && npm run build && node scripts/chrome-ops.mjs setup",
    "setup:windows": "npm run setup",
    "setup:macos": "npm run setup",
    "setup:linux": "npm run setup",
    "uninstall": "node scripts/chrome-ops.mjs uninstall",
    "uninstall:macos": "npm run uninstall",
    "uninstall:linux": "npm run uninstall",
    "uninstall:windows": "npm run uninstall",
    "doctor": "node scripts/chrome-ops.mjs doctor",
    "register": "node scripts/chrome-ops.mjs register",
    "register:claude": "node scripts/chrome-ops.mjs register claude",
    "register:codex": "node scripts/chrome-ops.mjs register codex",
    "register:cursor": "node scripts/chrome-ops.mjs register cursor",
    "register:grok": "node scripts/chrome-ops.mjs register grok",
    "test": "npm run build",
    "test:smoke": "node test/smoke.mjs",
    "test:devtools": "node test/devtools-smoke.mjs",
    "test:unit": "node --experimental-test-module-mocks --test test/adapters.test.mjs test/redaction.test.mjs test/remove.test.mjs test/host-profiles.test.mjs test/host-origin.test.mjs test/prepare-page.test.mjs test/load.test.mjs test/node-command.test.mjs test/linux-chrome.test.mjs test/audit-read.test.mjs test/audit-entry.test.mjs test/audit-chrome.test.mjs test/mcp-contract.test.mjs"
  },
  "keywords": [
    "mcp",
    "chrome",
    "devtools",
    "codex",
    "cursor",
    "grok",
    "claude",
    "developer-tools"
  ],
  "author": "kitepon.dev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "linkedom": "0.18.13",
    "typescript": "^7.0.2"
  }
}
