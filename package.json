{
  "name": "chrome-ops-mcp",
  "version": "1.0.0",
  "description": "MCP server for Chrome DevTools, extension management, and browser settings via a local Chrome extension.",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "chrome-ops-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "host": "node dist/host.js",
    "setup:windows": "pwsh -NoProfile -File scripts/setup-windows.ps1",
    "test": "npm run build",
    "test:smoke": "node test/smoke.mjs",
    "test:devtools": "node test/devtools-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
