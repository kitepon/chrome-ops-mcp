{
  "name": "chrome-ops-mcp",
  "version": "0.1.0",
  "description": "MCP server for Chrome DevTools, extension management, and browser settings via a local Chrome extension.",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "chrome-ops-mcp": "bin/chrome-ops-mcp.js" },
  "files": ["bin/","dist/","extension/","helper/","scripts/","docs/","README.md","SECURITY.md","LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "host": "node dist/host.js",
    "setup:windows": "pwsh -NoProfile -File scripts/setup-windows.ps1",
    "doctor": "pwsh -NoProfile -File scripts/doctor.ps1",
    "register:codex": "pwsh -NoProfile -File scripts/register-codex.ps1",
    "register:cursor": "pwsh -NoProfile -File scripts/register-cursor.ps1",
    "register:grok": "pwsh -NoProfile -File scripts/register-grok.ps1",
    "test": "npm run build",
    "test:smoke": "node test/smoke.mjs",
    "test:devtools": "node test/devtools-smoke.mjs"
  },
  "keywords": ["mcp","chrome","devtools","codex","cursor","grok","developer-tools"],
  "author": "kitepon.dev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
