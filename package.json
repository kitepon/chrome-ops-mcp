{
  "name": "chrome-ops-mcp",
  "version": "0.2.0-alpha.0",
  "description": "MCP server for Chrome DevTools, extension management, and browser settings via a local Chrome extension.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chrome-ops-mcp": "bin/chrome-ops-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "extension/",
    "helper/contract.ts",
    "helper/windows/",
    "helper/macos/Package.swift",
    "helper/macos/Sources/",
    "scripts/",
    "docs/ARCHITECTURE.md",
    "docs/CLIENTS.md",
    "docs/HELPER_WINDOWS.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "host": "node dist/host.js",
    "setup:windows": "pwsh -NoProfile -File scripts/setup-windows.ps1",
    "setup:macos": "node scripts/macos-host.mjs setup",
    "uninstall:macos": "node scripts/macos-host.mjs uninstall",
    "setup:linux": "npm ci && npm run build && node scripts/linux-host.mjs setup",
    "uninstall:linux": "node scripts/linux-host.mjs uninstall",
    "doctor": "node scripts/platform.mjs doctor",
    "register:codex": "node scripts/platform.mjs register-codex",
    "register:cursor": "node scripts/platform.mjs register-cursor",
    "register:grok": "node scripts/platform.mjs register-grok",
    "register:claude": "node scripts/platform.mjs register-claude",
    "test": "npm run build",
    "test:smoke": "node test/smoke.mjs",
    "test:devtools": "node test/devtools-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "chrome",
    "devtools",
    "codex",
    "cursor",
    "grok",
    "claude",
    "developer-tools"
  ],
  "author": "kitepon.dev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
